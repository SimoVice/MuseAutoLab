# Keep text files consistent across Windows and other platforms.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
# Preserve generated CAD bytes against their artifact manifests.
*.step -text -diff
*.STEP -text -diff
*.stl -text -diff
# Preserve recorded JSON bytes against their evidence hashes.
/docs/examples/microplate-tube-setup.json -text whitespace=cr-at-eol
/docs/examples/microplate-project.json -text
/docs/examples/microplate/geometry-report.json -text
/docs/examples/microplate/package-manifest.json -text
